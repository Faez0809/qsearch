backend/.venv/
backend/__pycache__/
backend/embeddings_cache.pkl
backend/.hf_models/

# Frontend
frontend/node_modules/
frontend/dist/

# Local datasets / media
QnA/
Udvash/
qsearch-media/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
EOF